{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "timezone": "Etc/UTC",
  "schedule": [
    "* 6 * * 1"
  ],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>rhysd/actionlint|gitleaks/gitleaks)\\s+[A-Z]+_VERSION: \"(?<currentValue>[^\"]+)\"\\s+[A-Z]+_SHA256: \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "LYCHEE_VERSION: \"(?<currentValue>[^\"]+)\"\\s+LYCHEE_SHA256: \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "depNameTemplate": "lycheeverse/lychee",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^lychee-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)\\s+version: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "Python",
      "semanticCommitType": "deps",
      "semanticCommitScope": "dev"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        ".github/tools/markdownlint/**"
      ],
      "groupName": "markdownlint",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    }
  ]
}
